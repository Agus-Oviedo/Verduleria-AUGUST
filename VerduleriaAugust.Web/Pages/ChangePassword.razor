@page "/cambiar-password"
@attribute [Authorize]
@inject AuthService Auth
@inject NavigationManager Navigation

<PageTitle>Crear contraseña · Augustu</PageTitle>
<div class="password-page"><section><div class="mark">A</div><p>PRIMER INGRESO</p><h1>Creá tu contraseña privada</h1><span>La contraseña temporal quedará invalidada. El administrador no podrá conocer tu nueva clave.</span>
    <label>Contraseña temporal<span class="password-input"><input type="@(ShowCurrent ? "text" : "password")" @bind="Current" autocomplete="current-password"/><button type="button" @onclick="() => ShowCurrent = !ShowCurrent">@(ShowCurrent ? "Ocultar" : "Ver")</button></span></label>
    <label>Nueva contraseña<span class="password-input"><input type="@(ShowNew ? "text" : "password")" @bind="NewPassword" autocomplete="new-password"/><button type="button" @onclick="() => ShowNew = !ShowNew">@(ShowNew ? "Ocultar" : "Ver")</button></span><small>Mínimo 10 caracteres</small></label>
    <label>Repetir nueva contraseña<span class="password-input"><input type="@(ShowConfirmation ? "text" : "password")" @bind="Confirmation" autocomplete="new-password"/><button type="button" @onclick="() => ShowConfirmation = !ShowConfirmation">@(ShowConfirmation ? "Ocultar" : "Ver")</button></span></label>
    @if(Error is not null){<div class="error">@Error</div>}<button class="submit-button" disabled="@IsSaving" @onclick="SaveAsync">@(IsSaving?"Guardando…":"Guardar mi contraseña")</button>
</section></div>
@code{private string Current{get;set;}="";private string NewPassword{get;set;}="";private string Confirmation{get;set;}="";private bool ShowCurrent{get;set;}private bool ShowNew{get;set;}private bool ShowConfirmation{get;set;}private string? Error{get;set;}private bool IsSaving{get;set;}private async Task SaveAsync(){if(NewPassword.Length<10){Error="La contraseña debe tener al menos 10 caracteres.";return;}if(NewPassword!=Confirmation){Error="Las contraseñas no coinciden.";return;}IsSaving=true;var result=await Auth.ChangePasswordAsync(Current,NewPassword);IsSaving=false;if(result.Success)Navigation.NavigateTo("/");else Error=result.ErrorMessage;}}
