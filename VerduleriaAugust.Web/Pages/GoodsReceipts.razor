@page "/mercaderia"
@attribute [Authorize(Roles="Administrador,Encargado")]
@inject GoodsReceiptsService Receipts
@inject ProductsService ProductsService
@inject NavigationManager Navigation
@inject IJSRuntime JS
<PageTitle>Mercadería · Augustu</PageTitle>
<div class="goods-page"><header><button @onclick="()=>Navigation.NavigateTo('/')">← Panel principal</button><strong>Augustu · Mercadería</strong><button @onclick="Load">Actualizar</button></header><main>
<section class="heading"><div><p>INVENTARIO</p><h1>Recepción de mercadería</h1><span>Ingresá varios productos en una sola operación auditada.</span></div></section>
@if(Error is not null){<div class="alert">@Error</div>}@if(Success is not null){<div id="operation-message" class="success">@Success</div>}
<details class="history-filter-card"><summary>Buscar en el historial · @HistoryTotal resultado(s)</summary><div class="history-filters"><input @bind="HistorySearch" placeholder="Número de recepción o remito…"/><select @bind="HistorySupplierId"><option value="0">Todos los proveedores</option>@foreach(var supplier in Suppliers){<option value="@supplier.Id">@supplier.Nombre</option>}</select><select @bind="HistoryStatus"><option value="">Todos los estados</option><option value="Confirmada">Confirmadas</option><option value="Anulada">Anuladas</option></select><label>Desde<input type="date" @bind="HistoryFrom"/></label><label>Hasta<input type="date" @bind="HistoryTo"/></label><div class="history-filter-actions"><button @onclick="ApplyHistoryFilters">Buscar</button><button @onclick="ClearHistoryFilters">Limpiar</button></div></div>@if(HistoryTotalPages>1){<nav class="history-pagination"><button disabled="@(HistoryPage<=1)" @onclick="PreviousHistoryPage">← Anterior</button><span>Página @HistoryPage de @HistoryTotalPages</span><button disabled="@(HistoryPage>=HistoryTotalPages)" @onclick="NextHistoryPage">Siguiente →</button></nav>}</details>
<section id="nueva-recepcion" class="receipt-form"><div class="form-head"><h2>Nueva recepción</h2><button @onclick="()=>ShowSupplier=!ShowSupplier">+ Proveedor</button></div>
@if(ShowSupplier){<div class="supplier-form"><input placeholder="Nombre" @bind="NewSupplierName"/><input placeholder="CUIT (opcional)" @bind="NewSupplierCuit"/><input placeholder="Contacto (opcional)" @bind="NewSupplierContact"/><button @onclick="CreateSupplier">Guardar proveedor</button></div>}
<div class="fields"><label>Proveedor<select @bind="SupplierId"><option value="0">Seleccionar…</option>@foreach(var supplier in Suppliers){<option value="@supplier.Id">@supplier.Nombre</option>}</select></label><label>Remito o comprobante<input @bind="Document"/></label><label>Observaciones<input @bind="Notes"/></label></div>
<div class="add-product"><div class="product-search"><input value="@ProductSearch" @oninput="SearchProducts" placeholder="Buscar producto por nombre o código…" autocomplete="off"/>@if(ShowProductResults){<div class="product-results">@if(FilteredProducts.Count==0){<p>No se encontraron productos.</p>}@foreach(var product in FilteredProducts){<button type="button" @onclick="()=>SelectProduct(product)"><span><strong>@product.Nombre</strong><small>@product.Codigo</small></span><em>Stock @(product.Stock?.StockActual.ToString("0.###")??"0") @(product.Stock?.UnidadMedida)</em></button>}</div>}</div><button class="quick-product-button" @onclick="()=>ShowQuickProduct=!ShowQuickProduct">+ Producto nuevo</button></div>
@if(ShowQuickProduct){<div class="quick-product"><h3>Crear producto sin salir de la recepción</h3><label>Nombre<input @bind="QuickName"/></label><label>Código <small>opcional</small><input @bind="QuickCode"/></label><label>Categoría<select @bind="QuickCategoryId"><option value="0">Seleccionar…</option>@foreach(var category in Categories){<option value="@category.Id">@category.Nombre</option>}</select></label><label>Se vende por<select @bind="QuickSaleType"><option value="Peso">Peso</option><option value="Unidad">Unidad</option></select></label><label>Precio de venta<input type="number" min="0.01" step="0.01" @bind="QuickPrice"/></label><button @onclick="CreateQuickProduct" disabled="@SavingQuickProduct">@(SavingQuickProduct?"Creando…":"Crear y agregar")</button></div>}
<div class="lines">@if(Lines.Count==0){<p class="empty-lines">Buscá y elegí un producto para comenzar la carga.</p>}@foreach(var line in Lines){<article><div class="line-product"><strong>@line.Name</strong><small>@line.Unit · stock actual: @line.CurrentStock.ToString("0.###")</small><small>Precio de venta vigente: <b>@(line.CurrentSalePrice.HasValue?$"$ {line.CurrentSalePrice:N2}":"Sin precio")</b></small><span>Stock luego del ingreso: <b>@line.ResultingStock.ToString("0.###") @line.Unit</b></span></div><label>Cantidad recibida <small>(@line.Unit)</small><input type="number" min="0.001" step="0.001" @bind="line.Quantity" @bind:event="oninput"/></label><label>Costo de compra por @line.Unit <small>(opcional)</small><input type="number" min="0" step="0.01" @bind="line.UnitCost" @bind:event="oninput"/></label><div class="line-subtotal"><small>Subtotal compra</small><b>$ @line.LineCost.ToString("N2")</b></div><button class="remove-line" title="Quitar producto" @onclick="()=>Lines.Remove(line)">×</button></article>}</div>
<div class="form-total"><span>Costo total de la compra</span><strong>$ @Lines.Sum(x=>x.LineCost).ToString("N2")</strong></div><button class="confirm" disabled="@Saving" @onclick="BeginConfirmation">Revisar y confirmar ingreso</button></section>
@if(Confirming){<div class="receipt-modal-backdrop"><section class="receipt-modal"><p>CONFIRMAR RECEPCIÓN</p><h2>Revisá el ingreso</h2><span>Proveedor: <b>@Suppliers.FirstOrDefault(x=>x.Id==SupplierId)?.Nombre</b></span><div class="receipt-summary">@foreach(var line in Lines){<div><span>@line.Name<br/><small>@line.Quantity.ToString("0.###") @line.Unit × $ @line.UnitCost.ToString("N2")</small></span><b>$ @line.LineCost.ToString("N2")</b></div>}</div><div class="modal-total"><span>Total de compra</span><b>$ @Lines.Sum(x=>x.LineCost).ToString("N2")</b></div><small>Al confirmar se aumentará el stock. El precio de venta no será modificado.</small><div class="modal-actions"><button @onclick="()=>Confirming=false" disabled="@Saving">Volver y corregir</button><button class="confirm" @onclick="SaveReceipt" disabled="@Saving">@(Saving?"Registrando…":"Confirmar ingreso")</button></div></section></div>}
<section class="history"><h2>Recepciones recientes</h2>@if(History.Count==0){<p>Sin recepciones registradas.</p>}@foreach(var receipt in History){<article class="@(receipt.Estado=="Anulada"?"cancelled-receipt":"")"><div><strong>@receipt.NumeroRecepcion</strong><span>@receipt.FechaRecepcion.ToString("dd/MM/yyyy HH:mm") · @receipt.Proveedor · @receipt.Usuario</span><span class="receipt-status">@receipt.Estado</span></div><b>$ @receipt.TotalCosto.ToString("N2")</b><details><summary>@receipt.Detalles.Count producto(s) · @(receipt.Comprobante??"Sin comprobante")</summary>@foreach(var detail in receipt.Detalles){<p>@detail.Producto · recibido @detail.Cantidad.ToString("0.###")@if(detail.CantidadCorregida>0){<text> · corregido @detail.CantidadCorregida.ToString("0.###") · neto @detail.CantidadPendiente.ToString("0.###")</text>} · costo $ @(detail.CostoUnitario?.ToString("N2")??"—")</p>}@if(!string.IsNullOrWhiteSpace(receipt.Observaciones)){<p><b>Observaciones:</b> @receipt.Observaciones</p>}</details><div class="receipt-actions"><AuthorizeView Roles="Administrador"><Authorized><button @onclick="()=>OpenAudit(receipt)">Ver auditoría</button></Authorized></AuthorizeView>@if(receipt.Estado!="Anulada"){<button @onclick="()=>OpenEdit(receipt)">Editar comprobante</button><button @onclick="()=>StartComplement(receipt)">Carga complementaria</button><button @onclick="()=>OpenCorrection(receipt)">Corregir cantidades</button><button class="danger" @onclick="()=>OpenCancellation(receipt)">Anular recepción</button>}</div></article>}</section>
</main></div>
@if(EditingReceipt is not null){<div class="receipt-modal-backdrop"><section class="receipt-modal"><p>EDITAR COMPROBANTE</p><h2>@EditingReceipt.NumeroRecepcion</h2><label>Proveedor<select @bind="EditSupplierId">@foreach(var supplier in Suppliers){<option value="@supplier.Id">@supplier.Nombre</option>}</select></label><label>Remito o comprobante<input @bind="EditDocument"/></label><label>Observaciones<textarea @bind="EditNotes"></textarea></label><label>Motivo de la modificación<input @bind="EditReason" placeholder="Obligatorio, mínimo 5 caracteres"/></label><small>Esta edición no modifica productos, cantidades, costos ni stock.</small><div class="modal-actions"><button @onclick="CloseHistoryModal" disabled="@SavingHistoryAction">Cancelar</button><button class="confirm" @onclick="SaveReceiptData" disabled="@SavingHistoryAction">@(SavingHistoryAction?"Guardando…":"Guardar cambios")</button></div></section></div>}
@if(CancellingReceipt is not null){<div class="receipt-modal-backdrop"><section class="receipt-modal cancellation-modal"><p>ANULAR RECEPCIÓN</p><h2>@CancellingReceipt.NumeroRecepcion</h2><span>Se descontarán del stock todas las cantidades de esta recepción.</span><label>Motivo de la anulación<textarea @bind="CancellationReason" placeholder="Obligatorio, mínimo 5 caracteres"></textarea></label><small>Si parte de la mercadería ya no está disponible, la API bloqueará la anulación completa.</small><div class="modal-actions"><button @onclick="CloseHistoryModal" disabled="@SavingHistoryAction">Volver</button><button class="confirm danger-confirm" @onclick="CancelReceipt" disabled="@SavingHistoryAction">@(SavingHistoryAction?"Anulando…":"Anular y revertir stock")</button></div></section></div>}
@if(CorrectingReceipt is not null){<div class="receipt-modal-backdrop"><section class="receipt-modal correction-modal"><p>CORRECCIÓN PARCIAL</p><h2>@CorrectingReceipt.NumeroRecepcion</h2><span>Indicá cuánto debe descontarse de cada producto.</span><div class="correction-lines">@foreach(var line in CorrectionLines){<label><span><b>@line.Product</b><small>Disponible para corregir: @line.Available.ToString("0.###")</small></span><input type="number" min="0" max="@line.Available" step="0.001" @bind="line.Quantity"/></label>}</div><label>Motivo de la corrección<textarea @bind="CorrectionReason" placeholder="Obligatorio, mínimo 5 caracteres"></textarea></label><small>La recepción original se conserva y se generarán movimientos de salida auditados.</small>@if(Error is not null){<div class="modal-error">@Error</div>}<div class="modal-actions"><button @onclick="CloseHistoryModal" disabled="@SavingHistoryAction">Volver</button><button class="confirm" @onclick="CorrectReceipt" disabled="@SavingHistoryAction">@(SavingHistoryAction?"Corrigiendo…":"Confirmar corrección")</button></div></section></div>}
@if(AuditReceipt is not null){<div class="receipt-modal-backdrop"><section class="receipt-modal audit-modal"><p>AUDITORÍA DE RECEPCIÓN</p><h2>@AuditReceipt.NumeroRecepcion</h2>@if(LoadingAudit){<span>Cargando historial…</span>}else if(AuditItems.Count==0){<span>Sin eventos registrados.</span>}else{<div class="audit-timeline">@foreach(var item in AuditItems){<article><i></i><div><b>@AuditLabel(item.Tipo)</b><span>@item.Fecha.ToString("dd/MM/yyyy HH:mm") · @item.Usuario</span><p>@item.Detalle</p></div></article>}</div>}@if(Error is not null){<div class="modal-error">@Error</div>}<button class="audit-close" @onclick="CloseHistoryModal">Cerrar</button></section></div>}
@code{
private List<SupplierItem> Suppliers=[];private List<ProductSummary> Products=[];private List<CategorySummary> Categories=[];private List<GoodsReceiptItem> History=[];private List<GoodsReceiptAuditItem> AuditItems=[];private List<ReceiptLine> Lines=[];private List<CorrectionLine> CorrectionLines=[];private int SupplierId,QuickCategoryId,EditSupplierId,HistorySupplierId,HistoryPage=1,HistoryTotal,HistoryTotalPages;private DateTime? HistoryFrom,HistoryTo;private string? Document,Notes,Error,Success,EditDocument,EditNotes;private bool Saving,ShowSupplier,ShowQuickProduct,SavingQuickProduct,ShowProductResults,Confirming,SavingHistoryAction,ScrollToComplementMessage,LoadingAudit;private string ProductSearch="",HistorySearch="",HistoryStatus="",NewSupplierName="",NewSupplierCuit="",NewSupplierContact="",QuickName="",QuickCode="",QuickSaleType="Peso",EditReason="",CancellationReason="",CorrectionReason="";private decimal QuickPrice;private GoodsReceiptItem? EditingReceipt,CancellingReceipt,CorrectingReceipt,AuditReceipt;
private List<ProductSummary> FilteredProducts=>string.IsNullOrWhiteSpace(ProductSearch)?[]:[..Products.Where(p=>p.Nombre.Contains(ProductSearch,StringComparison.OrdinalIgnoreCase)||p.Codigo.Contains(ProductSearch,StringComparison.OrdinalIgnoreCase)).Where(p=>Lines.All(line=>line.ProductId!=p.Id)).Take(8)];
protected override Task OnInitializedAsync()=>Load();private async Task Load(){try{Error=null;var suppliers=Receipts.GetSuppliersAsync();var products=ProductsService.GetActiveAsync();var categories=ProductsService.GetCategoriesAsync();var history=Receipts.GetHistoryAsync(HistoryPage,HistorySearch,HistorySupplierId>0?HistorySupplierId:null,HistoryStatus,HistoryFrom,HistoryTo);await Task.WhenAll(suppliers,products,categories,history);Suppliers=[..suppliers.Result];Products=[..products.Result];Categories=[..categories.Result];History=[..history.Result.Items];HistoryTotal=history.Result.Total;HistoryTotalPages=history.Result.TotalPaginas;}catch(Exception ex){Error=ex.Message;}}
private async Task ApplyHistoryFilters(){HistoryPage=1;await Load();}private async Task ClearHistoryFilters(){HistorySearch=HistoryStatus="";HistorySupplierId=0;HistoryFrom=HistoryTo=null;HistoryPage=1;await Load();}private async Task PreviousHistoryPage(){if(HistoryPage>1){HistoryPage--;await Load();}}private async Task NextHistoryPage(){if(HistoryPage<HistoryTotalPages){HistoryPage++;await Load();}}
protected override async Task OnAfterRenderAsync(bool firstRender){if(ScrollToComplementMessage){ScrollToComplementMessage=false;await JS.InvokeVoidAsync("augustu.scrollToAndHighlight","operation-message");}}
private void SearchProducts(ChangeEventArgs args){ProductSearch=args.Value?.ToString()??"";ShowProductResults=!string.IsNullOrWhiteSpace(ProductSearch);}
private void SelectProduct(ProductSummary product){if(Lines.All(x=>x.ProductId!=product.Id))Lines.Add(new(product.Id,product.Nombre,product.Stock?.UnidadMedida??"",product.Stock?.StockActual??0,product.TipoVenta=="Peso"?product.PrecioPorKilo:product.PrecioPorUnidad));ProductSearch="";ShowProductResults=false;}
private async Task CreateSupplier(){if(NewSupplierName.Trim().Length<2){Error="Indicá el nombre del proveedor.";return;}try{var p=await Receipts.CreateSupplierAsync(NewSupplierName.Trim(),NewSupplierCuit,NewSupplierContact);Suppliers.Add(p);SupplierId=p.Id;ShowSupplier=false;NewSupplierName=NewSupplierCuit=NewSupplierContact="";}catch(Exception ex){Error=ex.Message;}}
private async Task CreateQuickProduct(){if(QuickName.Trim().Length<2||QuickCategoryId<=0||QuickPrice<=0){Error="Indicá nombre, categoría y un precio de venta mayor a cero.";return;}SavingQuickProduct=true;Error=null;try{var code=string.IsNullOrWhiteSpace(QuickCode)?$"NUE-{DateTime.Now:MMddHHmmss}":QuickCode.Trim().ToUpperInvariant();await ProductsService.SaveAsync(null,new SaveProductRequest(code,QuickName.Trim(),QuickCategoryId,QuickSaleType,QuickSaleType=="Peso"?QuickPrice:null,QuickSaleType=="Unidad"?QuickPrice:null,0,QuickSaleType=="Peso"?"Kg":"Unidad",null,null,true));Products=[..await ProductsService.GetActiveAsync()];var created=Products.First(p=>p.Codigo.Equals(code,StringComparison.OrdinalIgnoreCase));Lines.Add(new(created.Id,created.Nombre,created.Stock?.UnidadMedida??(QuickSaleType=="Peso"?"Kg":"Unidad"),0,QuickPrice));ShowQuickProduct=false;QuickName=QuickCode="";QuickCategoryId=0;QuickSaleType="Peso";QuickPrice=0;}catch(Exception ex){Error=ex.Message;}finally{SavingQuickProduct=false;}}
private void BeginConfirmation(){Error=Success=null;if(SupplierId<=0||Lines.Count==0||Lines.Any(x=>x.Quantity<=0)){Error="Seleccioná proveedor y cargá cantidades mayores a cero.";return;}if(Lines.Any(x=>x.UnitCost<0)){Error="El costo de compra no puede ser negativo.";return;}Confirming=true;}
private async Task SaveReceipt(){Saving=true;Error=Success=null;try{var result=await Receipts.CreateReceiptAsync(SupplierId,Document,Notes,Lines.Select(x=>new GoodsReceiptLineRequest(x.ProductId,x.Quantity,x.UnitCost>0?x.UnitCost:null)).ToList());Success=$"Recepción {result.NumeroRecepcion} registrada. Stock actualizado por $ {result.TotalCosto:N2}.";Lines.Clear();Document=Notes=null;Confirming=false;await Load();}catch(Exception ex){Error=ex.Message;}finally{Saving=false;}}
private void OpenEdit(GoodsReceiptItem receipt){EditingReceipt=receipt;EditSupplierId=receipt.ProveedorId;EditDocument=receipt.Comprobante;EditNotes=receipt.Observaciones;EditReason="";Error=Success=null;}
private void OpenCancellation(GoodsReceiptItem receipt){CancellingReceipt=receipt;CancellationReason="";Error=Success=null;}
private void OpenCorrection(GoodsReceiptItem receipt){CorrectingReceipt=receipt;CorrectionReason="";CorrectionLines=[..receipt.Detalles.Where(d=>d.CantidadPendiente>0).Select(d=>new CorrectionLine(d.ProductoId,d.Producto,d.CantidadPendiente))];Error=Success=null;}
private async Task OpenAudit(GoodsReceiptItem receipt){AuditReceipt=receipt;AuditItems=[];LoadingAudit=true;Error=null;try{AuditItems=[..await Receipts.GetAuditAsync(receipt.Id)];}catch(Exception ex){Error=ex.Message;}finally{LoadingAudit=false;}}
private static string AuditLabel(string type)=>type switch{"Creada"=>"Recepción registrada","DatosEditados"=>"Datos del comprobante modificados","CorreccionParcial"=>"Cantidades corregidas","Anulada"=>"Recepción anulada",_=>type};
private void CloseHistoryModal(){EditingReceipt=CancellingReceipt=CorrectingReceipt=AuditReceipt=null;Error=null;}
private void StartComplement(GoodsReceiptItem receipt){SupplierId=receipt.ProveedorId;Document=receipt.Comprobante;Notes=$"Recepción complementaria de {receipt.NumeroRecepcion}";Error=null;Success="Carga complementaria preparada. Agregá únicamente los productos o cantidades que faltaron.";ScrollToComplementMessage=true;}
private async Task SaveReceiptData(){if(EditingReceipt is null)return;if(EditReason.Trim().Length<5){Error="Indicá el motivo de la modificación (mínimo 5 caracteres).";return;}SavingHistoryAction=true;Error=Success=null;try{Success=await Receipts.UpdateReceiptDataAsync(EditingReceipt.Id,EditSupplierId,EditDocument,EditNotes,EditReason.Trim());EditingReceipt=null;await Load();}catch(Exception ex){Error=ex.Message;}finally{SavingHistoryAction=false;}}
private async Task CancelReceipt(){if(CancellingReceipt is null)return;if(CancellationReason.Trim().Length<5){Error="Indicá el motivo de la anulación (mínimo 5 caracteres).";return;}SavingHistoryAction=true;Error=Success=null;try{Success=await Receipts.CancelReceiptAsync(CancellingReceipt.Id,CancellationReason.Trim());CancellingReceipt=null;await Load();}catch(Exception ex){Error=ex.Message;}finally{SavingHistoryAction=false;}}
private async Task CorrectReceipt(){if(CorrectingReceipt is null)return;var selected=CorrectionLines.Where(x=>x.Quantity>0).ToList();if(CorrectionReason.Trim().Length<5){Error="Indicá el motivo de la corrección (mínimo 5 caracteres).";return;}if(selected.Count==0){Error="Indicá al menos una cantidad para corregir.";return;}if(selected.Any(x=>x.Quantity>x.Available)){Error="Una cantidad supera lo disponible para corregir.";return;}SavingHistoryAction=true;Error=Success=null;try{Success=await Receipts.CorrectReceiptAsync(CorrectingReceipt.Id,CorrectionReason.Trim(),selected.Select(x=>new ReceiptCorrectionRequest(x.ProductId,x.Quantity)).ToList());CorrectingReceipt=null;await Load();}catch(Exception ex){Error=ex.Message;}finally{SavingHistoryAction=false;}}
private sealed class ReceiptLine(int id,string name,string unit,decimal stock,decimal? salePrice){public int ProductId{get;}=id;public string Name{get;}=name;public string Unit{get;}=unit;public decimal CurrentStock{get;}=stock;public decimal? CurrentSalePrice{get;}=salePrice;public decimal Quantity{get;set;}public decimal UnitCost{get;set;}public decimal ResultingStock=>CurrentStock+Quantity;public decimal LineCost=>Math.Round(Quantity*UnitCost,2);}
private sealed class CorrectionLine(int productId,string product,decimal available){public int ProductId{get;}=productId;public string Product{get;}=product;public decimal Available{get;}=available;public decimal Quantity{get;set;}}
}
