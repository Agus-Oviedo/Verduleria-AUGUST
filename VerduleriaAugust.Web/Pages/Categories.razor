@page "/categorias"
@attribute [Authorize(Roles = "Administrador,Encargado")]
@inject ProductsService ProductsService
@inject NavigationManager Navigation
<PageTitle>Categorías · Augustu</PageTitle>
<div class="categories-page"><header><button class="back" @onclick="GoToProducts">← Productos</button><div><strong>Augustu</strong><span>Categorías</span></div><button class="new" @onclick="OpenCreate">+ Nueva categoría</button></header><main><section class="heading"><div><p>CATÁLOGO</p><h1>Categorías</h1><span>Organización de los productos del negocio.</span></div><strong>@Total categoría(s)</strong></section><section class="filters"><input @bind="Search" placeholder="Buscar categoría…"/><select @bind="Filter"><option value="all">Todas</option><option value="active">Activas</option><option value="inactive">Inactivas</option></select><button @onclick="Apply">Buscar</button></section><section class="list">@if(IsLoading){<div class="message">Cargando…</div>}else if(Error is not null){<div class="message error">@Error</div>}else foreach(var item in Items){<article><div><strong>@item.Nombre</strong><span>Creada @item.FechaCreacion.ToString("dd/MM/yyyy")</span></div><span class="state @(item.Activa?"active":"inactive")">@(item.Activa?"Activa":"Inactiva")</span><button @onclick="()=>OpenEdit(item)">Editar</button></article>}</section></main>@if(ShowEditor){<div class="backdrop" @onclick="Close"><section class="dialog" @onclick:stopPropagation><button class="close" @onclick="Close">×</button><p>CATEGORÍAS</p><h2>@(EditingId.HasValue?"Editar categoría":"Nueva categoría")</h2><label>Nombre<input @bind="Name" maxlength="100"/></label>@if(EditingId.HasValue){<label class="check"><input type="checkbox" @bind="Active"/> Categoría activa</label>}@if(EditorError is not null){<div class="editor-error">@EditorError</div>}<button class="save" disabled="@IsSaving" @onclick="Save">@(IsSaving?"Guardando…":"Guardar categoría")</button></section></div>}</div>
@code{private List<CategorySummary> Items{get;}=[];private int Page{get;set;}=1;private int Total{get;set;}private string Search{get;set;}="";private string Filter{get;set;}="all";private bool IsLoading{get;set;}private string? Error{get;set;}private bool ShowEditor{get;set;}private int? EditingId{get;set;}private string Name{get;set;}="";private bool Active{get;set;}=true;private bool IsSaving{get;set;}private string? EditorError{get;set;}protected override Task OnInitializedAsync()=>Load();private async Task Load(){IsLoading=true;Error=null;try{bool? active=Filter switch{"active"=>true,"inactive"=>false,_=>null};var result=await ProductsService.GetCategoriesPagedAsync(Page,Search,active);Items.Clear();Items.AddRange(result.Items);Total=result.Total;}catch(Exception ex)when(ex is HttpRequestException or UnauthorizedAccessException){Error=ex.Message;}finally{IsLoading=false;}}private async Task Apply(){Page=1;await Load();}private void OpenCreate(){EditingId=null;Name="";Active=true;EditorError=null;ShowEditor=true;}private void OpenEdit(CategorySummary c){EditingId=c.Id;Name=c.Nombre;Active=c.Activa;EditorError=null;ShowEditor=true;}private void Close(){if(!IsSaving)ShowEditor=false;}private async Task Save(){if(string.IsNullOrWhiteSpace(Name)){EditorError="Ingresá el nombre.";return;}IsSaving=true;try{await ProductsService.SaveCategoryAsync(EditingId,Name,Active);ShowEditor=false;await Load();}catch(Exception ex)when(ex is HttpRequestException or InvalidOperationException or UnauthorizedAccessException){EditorError=ex.Message;}finally{IsSaving=false;}}private void GoToProducts()=>Navigation.NavigateTo("/productos");}
